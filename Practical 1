using Microsoft.AspNetCore.Mvc;
using System.Collections.Generic;
using System.Linq;

namespace MiniCrud.Controllers
{
    public class HomeController : Controller
    {
        // Simple Product model
        public class Product
        {
            public int Id { get; set; }
            public string Name { get; set; }
            public decimal Price { get; set; }
        }

        // Start with an empty list
        private static List<Product> products = new List<Product>();

        // Show list
        public IActionResult Index(int? editId)
        {
            ViewBag.EditId = editId;
            return View(products);
        }

        // Add product
        [HttpPost]
        public IActionResult Add(string name, decimal price)
        {
            int newId = products.Any() ? products.Max(p => p.Id) + 1 : 1;
            products.Add(new Product { Id = newId, Name = name, Price = price });
            return RedirectToAction("Index");
        }

        // Edit product
        [HttpPost]
        public IActionResult Edit(int id, string name, decimal price)
        {
            var p = products.FirstOrDefault(x => x.Id == id);
            if (p != null) { p.Name = name; p.Price = price; }
            return RedirectToAction("Index");
        }

        // Delete product
        [HttpPost]
        public IActionResult Delete(int id)
        {
            var p = products.FirstOrDefault(x => x.Id == id);
            if (p != null) products.Remove(p);
            return RedirectToAction("Index");
        }
    }
}
